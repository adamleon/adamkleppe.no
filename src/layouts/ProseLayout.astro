---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  heading?: string;
  lead?: string;
}

const { title, description, ogType = "website", heading, lead } = Astro.props;
---

<BaseLayout title={title} description={description} ogType={ogType}>
  <article class="mx-auto max-w-prose px-5 py-12">
    {heading && (
      <header class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold">{heading}</h1>
        {lead && (
          <p class="mt-3 text-lg text-ink-muted dark:text-paper/70">{lead}</p>
        )}
      </header>
    )}
    <div class="prose prose-neutral dark:prose-invert max-w-none prose-headings:font-serif">
      <slot />
    </div>
  </article>
</BaseLayout>
